# Másold .env-be és töltsd ki. A .env SOHA nem kerül a repóba vagy image-be.
# A végleges kulcslista a 2. és 4. fázisban rögzül.

# Claude: az előfizetésed kerete (Pro / Max). Token: `claude setup-token` (1 évig érvényes).
# ANTHROPIC_API_KEY-t NE állíts be: elsőbbséget kapna, és külön API-számlára menne (az agent el sem indul vele).
CLAUDE_CODE_OAUTH_TOKEN=

# IBKR (alapértelmezés: paper számla)
IBKR_TRADING_MODE=paper
IBKR_ACCOUNT_ID=

# Postgres (közös A2A task store; a jelszó tetszőleges, első induláskor ezzel jön létre)
POSTGRES_USER=auxin
POSTGRES_PASSWORD=
POSTGRES_DB=auxin

# IB Gateway container (dedikált paper login, lehetőleg 2FA nélkül; IBC naponta újraindítja)
IBKR_USERNAME=
IBKR_PASSWORD=
#IBKR_AUTO_RESTART_TIME=11:45 PM

# ibkrfacade: image (`make ibkrfacade-image` buildeli a ../ibkrfacade checkoutból)
#IBKRFACADE_IMAGE=ibkrfacade:local
# API tokenek, min. 16 karakter (openssl rand -hex 32); read: MCP szerver, write: csak az Execution
IBKRFACADE_TOKEN_READ=
IBKRFACADE_TOKEN_WRITE=
# Redis (az ibkrfacade árfolyam-cache-e)
IBKR_REDIS_PASSWORD=
