# Másold .env-be és töltsd ki. A .env SOHA nem kerül a repóba vagy image-be.
# A végleges kulcslista a 2. és 4. fázisban rögzül.

# Claude
ANTHROPIC_API_KEY=

# IBKR (alapértelmezés: paper számla)
IBKR_TRADING_MODE=paper
IBKR_ACCOUNT_ID=

# Postgres
POSTGRES_USER=auxin
POSTGRES_PASSWORD=
POSTGRES_DB=auxin

# Redis message bus (agentenként külön ACL user és jelszó)
REDIS_PASSWORD_MARKET_SENTIMENT=
REDIS_PASSWORD_RESEARCH=
REDIS_PASSWORD_PORTFOLIO_MANAGER=
REDIS_PASSWORD_EXECUTION=

# Költségplafon (USD / nap, összesen)
AUXIN_DAILY_COST_CAP_USD=
