# Másold .env-be és töltsd ki. A .env SOHA nem kerül a repóba vagy image-be.
# A végleges kulcslista a 2. és 4. fázisban rögzül.

# Claude: workspace-hez kötött Console API-kulcs (különben 400: anthropic-workspace-id kell)
ANTHROPIC_API_KEY=

# IBKR (alapértelmezés: paper számla)
IBKR_TRADING_MODE=paper
IBKR_ACCOUNT_ID=

# Postgres (közös A2A task store; a jelszó tetszőleges, első induláskor ezzel jön létre)
POSTGRES_USER=auxin
POSTGRES_PASSWORD=
POSTGRES_DB=auxin

# IB Gateway (dedikált paper login)
IBKR_USERNAME=
IBKR_PASSWORD=

# ibkrfacade API tokenek (read: PM, write: Execution)
IBKRFACADE_TOKEN_READ=
IBKRFACADE_TOKEN_WRITE=

# Költségplafon (USD / nap, összesen)
AUXIN_DAILY_COST_CAP_USD=
